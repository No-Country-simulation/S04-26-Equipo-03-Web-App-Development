# Supabase
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>
# Tras migrar Talent_profile en Supabase (availability, avatar_url, …): activá columnas extendidas en la API
# SUPABASE_TALENT_EXTENDED_SCHEMA=true
# Opcional: fuerza modo mínimo aunque exista EXTENDED (útil si varios .env)
# SUPABASE_TALENT_LEGACY_SCHEMA=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# opcional: carpeta dentro de Cloudinary
# CLOUDINARY_FOLDER=talents
# Tamaño máximo del archivo en bytes (Multer + validación). Por defecto 5242880 (5 MiB)
# CLOUDINARY_MAX_FILE_BYTES=5242880
# Solo imágenes: lado máximo (px) antes de subir; crop "limit" mantiene proporción. Por defecto 2048, tope 4096
# CLOUDINARY_IMAGE_MAX_EDGE_PX=2048
# false desactiva transformación/compresión automática en Cloudinary para imágenes
# CLOUDINARY_IMAGE_OPTIMIZE=true
# Foto perfil onboarding (Figma ~2 MiB)
# CLOUDINARY_PROFILE_MAX_FILE_BYTES=2097152
# PDF portfolio (Figma máx. 10 MiB)
# CLOUDINARY_PORTFOLIO_MAX_FILE_BYTES=10485760
